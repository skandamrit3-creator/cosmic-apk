COSMIC_ENV=development
COSMIC_HOST=127.0.0.1
COSMIC_PORT=8059
COSMIC_LOG_LEVEL=INFO
COSMIC_DATABASE=data/local/cosmic.db

# AI provider secrets belong in .env only.
# Never commit real API keys.
AI_PROVIDER=
AI_API_KEY=

# Optional photo-to-3D avatar generation (Tripo API; paid credits may be required).
# Store the real key in your private .env file only. Never commit it.
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211
TRIPO_CHARACTER_FACE_LIMIT=30000

# Required production authentication secret: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COSMIC_AUTH_SECRET=
COSMIC_TOKEN_TTL=604800
COSMIC_CORS_ORIGINS=https://your-cosmic-domain.example,capacitor://localhost,http://localhost
COSMIC_SOCKET_ORIGINS=https://your-cosmic-domain.example,capacitor://localhost,http://localhost

# Gemini remains server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede

# Neural speech fallback used only when Gemini Live cannot connect.
# Keep these secrets in the server-side .env file; never put them in frontend code.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Configure one server-side provider endpoint and key for each generation type.
# The provider must accept {prompt, ...options} and return JSON with id/task_id or a result.
COSMIC_IMAGE_PROVIDER=
COSMIC_IMAGE_GENERATION_URL=
COSMIC_IMAGE_API_KEY=
COSMIC_IMAGE_STATUS_URL=
COSMIC_VIDEO_PROVIDER=
COSMIC_VIDEO_GENERATION_URL=
COSMIC_VIDEO_API_KEY=
COSMIC_VIDEO_STATUS_URL=
