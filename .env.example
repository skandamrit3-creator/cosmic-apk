COSMIC_ENV=development
COSMIC_HOST=127.0.0.1
COSMIC_PORT=8059
COSMIC_LOG_LEVEL=INFO
COSMIC_DATABASE_URL=sqlite:///data/local/cosmic.db

# AI provider secrets belong in .env only.
# Never commit real API keys.
AI_PROVIDER=
AI_API_KEY=

# Optional photo-to-3D avatar generation (Tripo API; paid credits may be required).
# Store the real key in your private .env file only. Never commit it.
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211
TRIPO_CHARACTER_FACE_LIMIT=30000
