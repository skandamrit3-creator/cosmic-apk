# 5. Memory search
@app.get("/api/memory/search")
def search_memory():
    q = request.args.get("q", "").strip()
    if not q:
        return jsonify({"success": False, "error": "q is required"}), 400

    with get_connection() as db:
        rows = db.execute(
            "SELECT id,message,response,created_at FROM conversations "
            "WHERE message LIKE ? OR response LIKE ? "
            "ORDER BY id DESC LIMIT 100",
            (f"%{q}%", f"%{q}%")
        ).fetchall()

    return jsonify({
        "success": True,
        "count": len(rows),
        "items": [
            {"id": r[0], "message": r[1], "response": r[2], "created_at": r[3]}
            for r in rows
        ]
    })


# 6. Paginated memory
@app.get("/api/memory/page")
def memory_page():
    try:
        page = max(1, int(request.args.get("page", 1)))
        limit = min(100, max(1, int(request.args.get("limit", 20))))
    except ValueError:
        return jsonify({"success": False, "error": "invalid page or limit"}), 400

    offset = (page - 1) * limit

    with get_connection() as db:
        rows = db.execute(
            "SELECT id,message,response,created_at FROM conversations "
            "ORDER BY id DESC LIMIT ? OFFSET ?",
            (limit, offset)
        ).fetchall()

    return jsonify({
        "success": True,
        "page": page,
        "limit": limit,
        "items": [
            {"id": r[0], "message": r[1], "response": r[2], "created_at": r[3]}
            for r in rows
        ]
    })


